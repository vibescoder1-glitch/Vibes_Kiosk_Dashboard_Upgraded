NODE_ENV=production
PORT=3000
APP_HOST=0.0.0.0
APP_TIME_ZONE=Asia/Kolkata

# Preferred: a single PostgreSQL connection string (e.g. from Render).
DATABASE_URL=

# Optional: discrete PostgreSQL settings, used only when DATABASE_URL is not set.
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSL=true
DATABASE_CONNECTION_LIMIT=10
DATABASE_MAX_IDLE=5

# Generate independent random values of at least 32 characters for both secrets.
SESSION_SECRET=
FACE_TEMPLATE_SECRET=
FACE_MATCH_THRESHOLD=0.50

# Creates the one full-permission Supervisor dashboard account.
INITIAL_SUPERVISOR_NAME=Vibes Components
INITIAL_SUPERVISOR_EMAIL=
INITIAL_SUPERVISOR_PASSWORD=

# Existing deployments may keep using INITIAL_MANAGER_* during upgrade.

# Keep false in production. Enable only when deliberately loading demonstration data.
SEED_DEMO_DATA=false
